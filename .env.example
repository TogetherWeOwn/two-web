APP_NAME="Together We Own"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Postgres. `docker compose up -d` starts one that matches these values exactly.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=two_web
DB_USERNAME=two_web
DB_PASSWORD=two_web

# Everything below runs on the database. No Redis, no broker — if we ever need
# one, that is a conversation with the CEO, not a quiet .env change.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave this null. A shared parent domain (".togetherweown.com") would hand our
# session cookie to the WordPress store on the apex. See docs/dns.md.
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Discord OAuth application. Two values only, and never the bot token — that
# credential lives in the bot process and nowhere else. Ask the CEO (TWO-21); the
# values arrive through the secrets channel, never in an issue comment or chat.
#
# These must belong to the SAME Discord application as the bot, not a fresh one.
# Discord's add-guild-member endpoint — the one behind the one-click join that
# works on the live site today — only accepts a user token issued by the same
# application as the bot token making the call. A separate login application
# would work for signing in and silently kill one-click join. A client ID and
# secret are not the bot token and cannot be used to obtain it.
#
# One OAuth application serves every environment. The callback path is always
# /auth/discord/callback; only the host differs, and it is registered as a redirect
# URI on that one application. Nothing here hardcodes a hostname, so moving the
# site — to its launch subdomain now, to the apex later — is an .env change plus a
# redirect URI *added* in the Discord portal. Add before you switch, remove after:
# swapping the URI instead of adding one is a login outage.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI="${APP_URL}/auth/discord/callback"

# The TWO Discord server. Not a secret, but sign-in cannot work without it: roles
# are read per guild. Blank means nobody can sign in.
DISCORD_GUILD_ID=

# Which Discord roles get the moderator admin panel. Role IDs, comma separated —
# snowflakes, not names, so renaming a role in Discord cannot silently hand out or
# take away admin. Blank means nobody is a moderator, which is the safe default.
DISCORD_MODERATOR_ROLE_IDS=

# The bot's internal action endpoint (role grants, announcements, Discord events).
# Private network only. The shared secret signs the HMAC on every request.
BOT_ENDPOINT_URL=http://127.0.0.1:3001
BOT_SHARED_SECRET=
BOT_TIMEOUT_SECONDS=5

# Read-only Postgres role the bot grants us for its published views (TWO-23).
# Leave blank locally until those views exist; the site must degrade, not crash.
BOT_DB_HOST=127.0.0.1
BOT_DB_PORT=5432
BOT_DB_DATABASE=two_bot
BOT_DB_USERNAME=
BOT_DB_PASSWORD=

DUSK_DRIVER_URL=http://localhost:9515

VITE_APP_NAME="${APP_NAME}"
