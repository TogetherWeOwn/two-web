APP_NAME="Together We Own"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Postgres. `docker compose up -d` starts one that matches these values exactly.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=two_web
DB_USERNAME=two_web
DB_PASSWORD=two_web

# Everything below runs on the database. No Redis, no broker — if we ever need
# one, that is a conversation with the CEO, not a quiet .env change.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave this null. A shared parent domain (".togetherweown.com") would hand our
# session cookie to the WordPress store on the apex. See docs/dns.md.
SESSION_DOMAIN=null
# Explicit, never framework-default (CISO bar rule 6): staging and production
# both terminate TLS at the edge and trust the proxy (bootstrap/app.php), so
# the cookie is always Secure in practice. Safe on http://localhost too —
# loopback is a secure context, so local logins keep working.
SESSION_SECURE_COOKIE=true
# Lax, not Strict: the Discord OAuth callback is a top-level GET navigation and
# the state lookup needs the session cookie present. See docs/dns.md.
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Discord OAuth application. Two values only, and never the bot token — that
# credential lives in the bot process and nowhere else. Ask the CEO (TWO-21); the
# values arrive through the secrets channel, never in an issue comment or chat.
#
# These must belong to the SAME Discord application as the bot, not a fresh one.
# Discord's add-guild-member endpoint — the one behind the one-click join that
# works on the live site today — only accepts a user token issued by the same
# application as the bot token making the call. A separate login application
# would work for signing in and silently kill one-click join. A client ID and
# secret are not the bot token and cannot be used to obtain it.
#
# One OAuth application serves every environment. The callback path is always
# /auth/discord/callback; only the host differs, and it is registered as a redirect
# URI on that one application. Nothing here hardcodes a hostname, so moving the
# site — to its launch subdomain now, to the apex later — is an .env change plus a
# redirect URI *added* in the Discord portal. Add before you switch, remove after:
# swapping the URI instead of adding one is a login outage.
#
# There is no DISCORD_REDIRECT_URI. The callback address is built from APP_URL and
# the route, because a separate variable is a way to ship a staging box that still
# tells Discord "localhost" — and Discord rejects a mismatch at its own error
# screen, where we cannot apologise. Set APP_URL correctly and the rest follows.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# The TWO Discord server. Leave this blank — config/services.php already defaults
# to the TWO server (326474832151838730), because there is only one and a blank
# used to mean nobody could sign in at all. Set it only to point a box somewhere
# else, e.g. QA's own test server. Not a secret: anyone can check it with
# curl https://discord.com/api/v10/guilds/326474832151838730/widget.json
DISCORD_GUILD_ID=

# Where /discord sends people. Leave this blank too — config/services.php already
# defaults to the WEB-HOMEPAGE campaign invite, which was created never expiring
# and unlimited use for exactly this route, and web arrivals attribute to it.
# Set it only to point a box at a different server, e.g. QA's own.
#
# Not a secret: it is a public join link, and the funnel must work on a fresh
# deploy with no secret store reachable. It must be an https URL on discord.gg or
# discord.com — anything else is refused and the hardcoded fallback is served
# instead, so this can never be turned into an open redirect.
DISCORD_INVITE_URL=

# Which Discord roles get the moderator admin panel. Role IDs, comma separated —
# snowflakes, not names, so renaming a role in Discord cannot silently hand out or
# take away admin. Blank means nobody is a moderator, which is the safe default.
DISCORD_MODERATOR_ROLE_IDS=

# Staging only. Keep this unset everywhere else. The value is provisioned through
# Paperclip/Coolify secret controls and is accepted only in the X-TWO-QA-Auth header.
# Never put it in a URL, request body, log, screenshot, or repository file.
TWO_WEB_STAGING_QA_AUTH_TOKEN=

# Reads of member data through the admin panel are logged: who, when, which
# members. See docs/member-data-access-log.md — the log is the condition on the
# role above being configured narrowly and widened later, because "we can narrow
# it later" is only true if we can say who looked in the meantime.
#
# Both of these have working defaults and neither normally appears in a real .env.
# Setting ENFORCE=false is a decision to serve member data with no record of who
# read it; it is not a performance tuning knob.
MEMBER_ACCESS_LOG_RETENTION_DAYS=90
MEMBER_ACCESS_LOG_ENFORCE=true

# Join funnel and agent replay-store retention. Both default to 90 days and
# neither normally appears in a real .env — they are here so the windows are
# discoverable. The funnel widget shows the retention window, not all time.
JOIN_ATTEMPT_RETENTION_DAYS=90
AGENT_EVENTS_IDEMPOTENCY_RETENTION_DAYS=90

# The bot's internal action endpoint (role grants, announcements, Discord events).
# Private network only. The shared secret signs the HMAC on every request.
#
# BOT_KEY_ID names which of the bot's `TWO_INTERNAL_KEYS` pairs the secret below
# belongs to, and is how a secret gets rotated without downtime: add a second pair
# on the bot, point this at it, retire the first. It must match a key id the bot
# knows — a wrong one comes back as an `unauthorized` byte-identical to a forged
# signature, so there is nothing in the failure to tell you which it was.
BOT_ENDPOINT_URL=http://127.0.0.1:3001
BOT_KEY_ID=web-local
BOT_SHARED_SECRET=
BOT_TIMEOUT_SECONDS=5

# Read-only Postgres role the bot grants us for its published views (TWO-23).
# Leave blank locally until those views exist; the site must degrade, not crash.
BOT_DB_HOST=127.0.0.1
BOT_DB_PORT=5432
BOT_DB_DATABASE=two_bot
BOT_DB_USERNAME=
BOT_DB_PASSWORD=

# Date the house rules were last reviewed, shown as a stamp on /rules
# (TOG-7323). Optional — config/community.php defaults to the last review
# date. Maintainers: bump this whenever the rules change. An empty or
# unparseable value hides the stamp (and logs a warning) rather than 500ing
# the page, so a typo here degrades, never breaks.
RULES_LAST_UPDATED=

DUSK_DRIVER_URL=http://localhost:9515

VITE_APP_NAME="${APP_NAME}"
