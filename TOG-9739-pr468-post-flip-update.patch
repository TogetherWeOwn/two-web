+keys_of "$EXAMPLE" > "$EXAMPLE_KEYS_TMP"
+keys_of "$STAGING_FILE" > "$STAGING_KEYS_TMP"
+keys_of "$PROD_FILE" > "$PROD_KEYS_TMP"
