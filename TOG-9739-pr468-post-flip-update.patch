+        'description' => 'Bring a friend, bring spare ammo.',
+        'location' => 'Voice: General',
+        'starts_at' => now()->addDays(3),
+        'ends_at' => now()->addDays(3)->addHours(2),
+        'status' => EventStatus::Published,
+    ]);
+}
+
