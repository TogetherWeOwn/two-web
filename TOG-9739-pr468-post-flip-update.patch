+EXAMPLE_KEYS_TMP=$(mktemp "${TMPDIR:-/tmp}/env-parity-example.XXXXXX")
+STAGING_KEYS_TMP=$(mktemp "${TMPDIR:-/tmp}/env-parity-staging.XXXXXX")
+PROD_KEYS_TMP=$(mktemp "${TMPDIR:-/tmp}/env-parity-prod.XXXXXX")
