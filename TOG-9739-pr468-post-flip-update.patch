diff --git a/resources/css/app.css b/resources/css/app.css
index 012174fe..26aa8898 100644
--- a/resources/css/app.css
+++ b/resources/css/app.css
@@ -74,3 +74,48 @@ @media (prefers-reduced-motion: reduce) {
    the paginator and any packaged Blade component render unstyled. */
 @source '../../vendor/laravel/framework/src/Illuminate/Pagination/resources/views/*.blade.php';
 @source '../../storage/framework/views/*.php';
+
+/* TOG-6932: the public focus pass. The vendored two.css focus treatment is
+   correct on the dark system it was designed for — a near-white ring at
+   17.5:1 on canvas — but the homepage renders on ledger paper, where the same
+   ring measures 1.05:1 and is invisible (WCAG 2.4.13 needs 3:1 against
+   adjacent colours). This layer overrides it per scheme with each scheme's
+   own ink, which two-design's contrast gate already pins at 15.2:1
+   (ledger) and 14.5:1 (taste) on its paper.
+
+   Lives here, not in two.css: that file is vendored from two-design and
+   digest-pinned by tests/Unit/VendoredTokensTest.php. A dark-ground page keeps
+   the vendored ring untouched. */
+:where(.bg-ledger-paper, .bg-taste-paper) :where(a, button, input, select, textarea, summary, [tabindex]):focus-visible {
+    outline-color: var(--color-ledger-ink);
+}
+
+.bg-taste-paper :where(a, button, input, select, textarea, summary, [tabindex]):focus-visible {
+    outline-color: var(--color-taste-ink);
+}
+
+/* The skip link. `sr-only focus:not-sr-only` reveals it on keyboard focus,
+   but revealed as bare text on the page ground it is a 1.4:1 smear on ledger
+   paper; nobody can read the control they just found. This makes the revealed
+   state an opaque pill on the light schemes only: canvas fill, near-white
+   text (16.7:1 on the fill), and the fill itself at 16.6:1 on ledger paper /
+   17.4:1 on taste paper, so the pill reads as one control. The outline sits
+   in the 2px offset gap on the paper (15.2:1 ledger, 14.5:1 taste). Scoped to
+   the light schemes on purpose: on a dark page the canvas fill would equal
+   the ground and the ledger outline would fall to ~1.1:1, replacing the
+   vendored 17.5:1 ring — dark pages keep the vendored ring untouched.
+   `position: relative` makes the `z-index` take effect above the hero. */
+:where(.bg-ledger-paper, .bg-taste-paper) a[href='#main']:focus-visible {
+    background-color: var(--color-canvas);
+    color: var(--color-ink);
+    outline: 2px solid var(--color-ledger-ink);
+    outline-offset: 2px;
+    border-radius: var(--radius-sm);
+    padding: 0.5rem 1rem;
+    position: relative;
+    z-index: 50;
+}
+
+.bg-taste-paper a[href='#main']:focus-visible {
+    outline-color: var(--color-taste-ink);
+}
