+        ->set('bio', $payload)
+        ->call('save')
+        ->assertSet('editing', true)
+        ->assertHasErrors(['bio']);
+
+    expect($profile->fresh()->bio)->toBe('Before');
+})->with([
+    'NUL byte' => ['a'.chr(0).'b'],
+    'SOH' => ["a\x01b"],
+    'backspace' => ["a\x08b"],
+    'form feed' => ["a\x0cb"],
+    'DEL' => ["a\x7fb"],
