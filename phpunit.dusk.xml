<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Browser">
            <directory>tests/Browser</directory>
        </testsuite>
    </testsuites>
    <php>
        <!-- Dusk drives a real browser against a real server, so it uses whatever
             database `php artisan serve` is using — your local `two_web`. It will
             write to it. That is normal Dusk; do not point this at anything you
             care about, and never at staging or production. -->
        <env name="APP_ENV" value="local"/>
        <!-- The separately running application and worker use the real database
             queue configured in .env. A PHPUnit-only sync override would bypass
             the cross-process seam this suite exists to prove. -->
        <env name="QUEUE_CONNECTION" value="database"/>
    </php>
</phpunit>
